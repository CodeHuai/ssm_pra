<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.huai.ssm.mapper.FurnMapper">
    <insert id="save" parameterType="com.huai.ssm.bean.FurnBean">
        insert into furn(name, marker, price, sales, stock, img_path)
        values (#{name}, #{marker}, #{price}, #{sales}, #{stock}, #{imgPath})
    </insert>

    <select id="findAllFurns" resultType="com.huai.ssm.bean.FurnBean">
        select *
        from furn
    </select>

    <update id="updateFurn" parameterType="com.huai.ssm.bean.FurnBean">
        update furn
        set name=#{name},
            marker=#{marker},
            price=#{price},
            sales=#{sales},
            stock=#{stock},
            img_path=#{imgPath}
        where id = #{id}
    </update>


    <select id="getDetailById" resultType="com.huai.ssm.bean.FurnBean" parameterType="int">
        select *
        from furn
        where id = #{id}
    </select>

    <delete id="removeDataById" parameterType="int">
        delete
        from furn
        where id = #{id}
    </delete>
</mapper>
